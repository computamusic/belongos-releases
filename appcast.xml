    <item>
      <title>1.0.7</title>
      <pubDate>Sun, 30 Aug 2026 04:44:21 +0000</pubDate>
      <sparkle:version>202608300042</sparkle:version>
      <sparkle:shortVersionString>1.0.7</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>26.0</sparkle:minimumSystemVersion>
      <description>Financials and Setup now have their sub-views: Expenses, Bank Inbox, Payroll and Projections; Team, Products, Series, Playbooks, SOPs and Metrics. Several of these had no way into the Mac app before.</description>
      <enclosure url="https://github.com/computamusic/belongos-releases/releases/download/v1.0.7/BelongOS-1.0.7.dmg" length="3283087" type="application/octet-stream" sparkle:edSignature="nvBeLpP7DSVe5YxJzCVxRIirSMWBiy/0C8zSL9Wdt76zG4NztizCl+jHicgGSorY+tCkV1ATIzIhHNhf9GROAg==" />
    </item>
    <item>
      <title>1.0.6</title>
      <pubDate>Sun, 30 Aug 2026 04:30:35 +0000</pubDate>
      <sparkle:version>202608300028</sparkle:version>
      <sparkle:shortVersionString>1.0.6</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>26.0</sparkle:minimumSystemVersion>
      <description>Staff finally has its icon, and sections with sub-views now show them as tabs instead of hiding them in a dropdown — Partners has seven. Reports gains Activity and Sessions.</description>
      <enclosure url="https://github.com/computamusic/belongos-releases/releases/download/v1.0.6/BelongOS-1.0.6.dmg" length="3279517" type="application/octet-stream" sparkle:edSignature="Il2MTxTHAELXovgo0JANXTtzHY7EYGsSGLeF0koLZ5C3vbK4F/qOYgAdoeCL6PFgaRHEcMu0yR+NlvJTOD9hDg==" />
    </item>
    <item>
      <title>1.0.5</title>
      <pubDate>Sun, 30 Aug 2026 04:21:10 +0000</pubDate>
      <sparkle:version>202608300019</sparkle:version>
      <sparkle:shortVersionString>1.0.5</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>26.0</sparkle:minimumSystemVersion>
      <description>The Room: the team chat with your resident AI teammate — she reads the room, answers with real numbers from your CRM, and stages changes as cards you approve or decline. Set your own name and face from the room's toolbar. Plus faster message delivery and a pile of fixes.</description>
      <enclosure url="https://github.com/computamusic/belongos-releases/releases/download/v1.0.5/BelongOS-1.0.5.dmg" length="3265794" type="application/octet-stream" sparkle:edSignature="KC6B0dyHrtnZ3u33c0fwGOCIcNIe3h7oaeFh3GeXIaUvrYTteDPhoiungQrx6lZOqZWCXD9TcD348AZQcs4KAQ==" />
