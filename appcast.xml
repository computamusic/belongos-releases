    <item>
      <title>1.0.10</title>
      <pubDate>Sun, 30 Aug 2026 05:51:53 +0000</pubDate>
      <sparkle:version>202608300149</sparkle:version>
      <sparkle:shortVersionString>1.0.10</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>26.0</sparkle:minimumSystemVersion>
      <description>The sidebar is grouped into Operations, Money and Workspace. Events and every records list now open on something instead of a 'select an item' void, and empty lists say what is missing.</description>
      <enclosure url="https://github.com/computamusic/belongos-releases/releases/download/v1.0.10/BelongOS-1.0.10.dmg" length="3316746" type="application/octet-stream" sparkle:edSignature="05sR+k1tN9N3pV5lyX4voVC+xjZkCaOmcB+FYnD4OwREKZeQPRro7d6mUVLezZ79gMG6pIjti2buTyjT3J9mCQ==" />
